# ==============================================================================
# CODELOL ENVIRONMENT VARIABLES
# Copy this file to .env.local and configure your API keys
# ==============================================================================

# Supabase Configuration (Required)
# Found under Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (Only needed for administrative tasks/cron)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: OnlineCompiler.io or External Code Runner API Key
# ONLINE_COMPILER_API_KEY=your-onlinecompiler-api-key

# Optional: Node Environment
NODE_ENV=development

