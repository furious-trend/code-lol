# ==============================================================================
# CODELOL ENVIRONMENT VARIABLES
# Copy this file to .env.local and configure your API keys
# ==============================================================================

# Supabase Configuration (Required)
# Found under Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (Only needed for administrative tasks/cron)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: OnlineCompiler.io or External Code Runner API Key
# ONLINECOMPILER_API_KEY=your-onlinecompiler-api-key

# Optional: Canonical public site URL used in SEO routes and OpenGraph
# NEXT_PUBLIC_SITE_URL=https://code-lol-three.vercel.app

# Optional: Node Environment
NODE_ENV=development



# Hugging Face Client-Side AI Model (Public GGUF repo — never place HF tokens in NEXT_PUBLIC_ vars)
NEXT_PUBLIC_HF_MODEL_REPO=shafiqahmed0075/codelol
NEXT_PUBLIC_HF_MODEL_FILE=codelol.gguf
